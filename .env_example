# Secrets and settings for Simple EDL Hoster. Do not commit this file.

# Flask session signing key. Must be identical across all workers.
FLASK_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# Password for the "admin" user. Only used when the user table is empty (first run).
# To change it later, update the DB (see README) or delete edl_users.db and restart.
EDL_ADMIN_PASSWORD=change-me

# Bind address and port
EDL_HOST=0.0.0.0
EDL_PORT=5500

# Directory of feed files (relative to the app or absolute). Every *.txt is served at /edl/<name>.txt
EDL_FEED_DIR=feeds

# --- Production (gunicorn behind nginx) ---
# Gunicorn bind address; keep on loopback and let nginx face the network
GUNICORN_BIND=127.0.0.1:5500
GUNICORN_WORKERS=2
# Set both to 1 once nginx is terminating TLS in front of the app
EDL_BEHIND_PROXY=0
EDL_COOKIE_SECURE=0
